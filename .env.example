# Supabase URL and PUBLIC key only. Never put service_role in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-or-anon-key

# Server-only email worker. Leave external sending disabled until verified.
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=ALYS Pool Services <service@your-verified-domain.example>
SUPABASE_SERVICE_ROLE_KEY=
REPORT_WORKER_SECRET=

# Optional map/road routing configuration. No driving estimates are fabricated if unset.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
ROUTING_API_URL=
# Optional Nominatim-compatible search endpoint; manual coordinates work without it.
GEOCODING_API_URL=

# Customer portal invitations require your actual portal and Supabase SMTP.
CUSTOMER_INVITES_ENABLED=false
CUSTOMER_PORTAL_URL=
