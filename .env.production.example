# Copy to .env.production.local (ignored by Git). Never commit real values.
# Hosted Supabase project; all migrations must be applied before launch.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Keep false until ready for a controlled real email test.
EMAIL_DELIVERY_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=ALYS Pool Services <reports@alyspools.com>
# The domain must first show Verified in Resend. DNS instructions are in README.md.
REPORT_WORKER_SECRET=
# Netlify supplies URL automatically for the production recovery schedule.

# Owner provisioning only. Remove after setup; do not add this to website build variables.
ALYS_INITIAL_OWNER_PASSWORD=

# Core visit/photo/email operation does not require map services or invitations.
CUSTOMER_INVITES_ENABLED=false
ROUTING_API_URL=
GEOCODING_API_URL=

# V2: enable only after verifying sender and testing the invitation acceptance flow.
TEAM_INVITES_ENABLED=false
# Optional Geoapify adapter; use only after accepting current Free/commercial terms.
GEOCODING_PROVIDER=
GEOCODING_API_KEY=
GEOCODING_AUTOCOMPLETE_ENABLED=false

# V2.1 runtime settings (server-only; configure in Netlify Functions scope).
# Canonical public origin, without a path or trailing query. Netlify URL is a fallback.
APP_URL=https://app.alyspools.com
# Optional valid mailbox you control, for replies to reports and invitations.
EMAIL_REPLY_TO=
# Resend webhook signing secret for verified delivered/bounced/complained/failed events.
RESEND_WEBHOOK_SECRET=
# Optional safe label: production, staging or demo. This does not enable demo isolation.
APP_ENV=production
